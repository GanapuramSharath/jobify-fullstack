{
  "name": "jobify",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "setup-project": "npm install && cd client && npm install",
    "server": "nodemon server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "concurrently": "^8.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.7",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "fs": "^0.0.1-security",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nanoid": "^4.0.2",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
